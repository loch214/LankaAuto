# Copy to `.env` and fill in the real values. `.env` is gitignored; this file
# is committed so a fresh clone knows which variables the project needs.

# --- Database --------------------------------------------------------------
# Matches docker-compose.yml. Port 5433, not 5432 (see the comment there).
# These credentials are local-development-only and intentionally not secret.
DATABASE_URL="postgresql://lankaauto:lankaauto_dev@localhost:5433/lankaauto?schema=public"

# SHADOW_DATABASE_URL is deliberately NOT set.
#
# `prisma migrate dev` needs a scratch database to detect schema drift. When
# the connecting role is a superuser it creates and drops one automatically,
# which is the case here — so there is nothing to configure. This becomes
# necessary only on a hosted Postgres where the role cannot CREATE DATABASE.

# --- AI --------------------------------------------------------------------
# Google AI Studio key: https://aistudio.google.com/apikey
# Used ONLY for embeddings (gemini-embedding-001, 768 dims) and the LLM
# fallback in the ingestion parser. NOT needed for Milestone 1A.
GEMINI_API_KEY="your-key-here"

# Groq key (free): https://console.groq.com/keys — powers the Phase 5
# customer chat agent's function calling (services/agent/groq-client.ts).
# Moved off Gemini because Gemini's free-tier generateContent measured
# 11-27s per customer message in production; Groq's inference hardware is
# built for speed and doesn't have that problem. REQUIRED for the chat
# widget to work.
GROQ_API_KEY="your-key-here"
# Groq's model catalogue varies by account — run `npm run bench:chat` or hit
# GET /openai/v1/models to see what your key actually has.
GROQ_CHAT_MODEL="openai/gpt-oss-120b"

# --- Staff auth --------------------------------------------------------------
# Signs staff JWTs. Generate a real one per environment with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never reuse the dev value in production — anyone with it can mint a valid
# staff/admin token for any user id.
JWT_SECRET="dev-only-change-me"

# Used only by `npm run seed:admin` to create the first ADMIN user. Not read
# anywhere else — the running app never sees a plaintext staff password.
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL="admin@lankaauto.local"
SEED_ADMIN_PASSWORD="change-me-now"
