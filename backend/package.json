{
  "name": "lankaauto-backend",
  "version": "0.1.0",
  "private": true,
  "description": "LankaAuto backend — catalogue API, ingestion pipeline, and retrieval",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:up": "docker compose -f ../docker-compose.yml up -d",
    "db:down": "docker compose -f ../docker-compose.yml down",
    "db:nuke": "docker compose -f ../docker-compose.yml down -v",
    "db:logs": "docker compose -f ../docker-compose.yml logs -f db",
    "db:psql": "docker compose -f ../docker-compose.yml exec db psql -U lankaauto -d lankaauto",
    "db:studio": "prisma studio",
    "migrate": "prisma migrate dev --create-only",
    "db:reset": "prisma migrate reset --force",
    "generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "check:db": "tsx src/scripts/check-db.ts",
    "ingest:gmb-ujoint": "tsx src/scripts/ingest-gmb-ujoint.ts",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "seed:categories": "tsx src/scripts/seed-categories.ts",
    "embed:parts": "tsx src/scripts/embed-parts.ts",
    "search": "tsx src/scripts/search-cli.ts",
    "eval": "tsx src/scripts/run-eval.ts",
    "dev": "tsx watch src/server.ts",
    "db:verify": "npm run db:reset && npm run check:db",
    "migrate:apply": "prisma migrate deploy && npm run check:db",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.2.5",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.5",
    "@types/supertest": "^7.2.1",
    "prisma": "^6.1.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
